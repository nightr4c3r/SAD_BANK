<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #F5F7FA;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.loginpf.Controllers.AdminController">
    <children>
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #0B0F12;" text="SAD Bank - Admin" AnchorPane.leftAnchor="16.0" AnchorPane.topAnchor="12.0">
            <font><Font size="18.0" /></font>
        </Label>
        <Button onAction="#onLogout" prefHeight="30.0" prefWidth="120.0" style="-fx-background-color: #4B5563; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Cerrar sesión" AnchorPane.rightAnchor="16.0" AnchorPane.topAnchor="12.0" />

        <TabPane AnchorPane.bottomAnchor="12.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="52.0">
            <tabs>
                <Tab closable="false" text="Clientes">
                    <content>
                        <AnchorPane>
                            <children>
                                <TitledPane text="Gestionar clientes" collapsible="false" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
                                    <content>
                                        <VBox spacing="8.0" styleClass="card">
                                            <children>
                                                <HBox spacing="8.0">
                                                    <children>
                                                        <Label text="Seleccionar cliente:" />
                                                        <ComboBox fx:id="cmbClients" prefWidth="220.0" />
                                                        <Button onAction="#onLoadClientFromDropdown" text="Cargar" />
                                                    </children>
                                                </HBox>
                                                <GridPane hgap="8" vgap="8">
                                                    <columnConstraints>
                                                        <ColumnConstraints percentWidth="20" />
                                                        <ColumnConstraints percentWidth="30" />
                                                        <ColumnConstraints percentWidth="20" />
                                                        <ColumnConstraints percentWidth="30" />
                                                    </columnConstraints>
                                                    <rowConstraints>
                                                        <RowConstraints />
                                                        <RowConstraints />
                                                        <RowConstraints />
                                                        <RowConstraints />
                                                    </rowConstraints>
                                                    <children>
                                                        <Label text="Usuario" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                                                        <TextField fx:id="txtCUsername" promptText="usuario" GridPane.rowIndex="0" GridPane.columnIndex="1" />
                                                        <Label text="Contraseña" GridPane.rowIndex="0" GridPane.columnIndex="2" />
                                                        <PasswordField fx:id="txtCPassword" promptText="contraseña" GridPane.rowIndex="0" GridPane.columnIndex="3" />

                                                        <Label text="Nombre" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                                                        <TextField fx:id="txtCName" promptText="nombre" GridPane.rowIndex="1" GridPane.columnIndex="1" />
                                                        <Label text="ID" GridPane.rowIndex="1" GridPane.columnIndex="2" />
                                                        <TextField fx:id="txtCId" promptText="identificación" GridPane.rowIndex="1" GridPane.columnIndex="3" />

                                                        <Label text="Cuenta" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                                                        <TextField fx:id="txtCAccount" promptText="número de cuenta" GridPane.rowIndex="2" GridPane.columnIndex="1" />
                                                        <Label text="Saldo" GridPane.rowIndex="2" GridPane.columnIndex="2" />
                                                        <TextField fx:id="txtCBalance" promptText="saldo" GridPane.rowIndex="2" GridPane.columnIndex="3" />

                                                        <Label text="Tipo de cuenta" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                                                        <ComboBox fx:id="cmbCType" GridPane.rowIndex="3" GridPane.columnIndex="1" />
                                                        <HBox spacing="8.0" GridPane.rowIndex="3" GridPane.columnIndex="3" alignment="CENTER_RIGHT">
                                                            <children>
                                                                <Button onAction="#onAddClient" text="Agregar" />
                                                                <Button onAction="#onUpdateClient" text="Actualizar" />
                                                                <Button fx:id="btnRemoveClient" onAction="#onRemoveClient" text="Eliminar" />
                                                                <Button fx:id="btnPromoteClient" onAction="#onPromoteClientToAdmin" text="Hacer Admin" />
                                                            </children>
                                                        </HBox>
                                                    </children>
                                                </GridPane>
                                            </children>
                                        </VBox>
                                    </content>
                                </TitledPane>

                                <TableView id="tblClients" fx:id="tblClients" editable="false" style="-fx-control-inner-background: white; -fx-background-color: transparent;" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="230.0">
                                    <columns>
                                        <TableColumn fx:id="colCUsername" prefWidth="150.0" text="Usuario" />
                                        <TableColumn fx:id="colCName" prefWidth="180.0" text="Nombre" />
                                        <TableColumn fx:id="colCId" prefWidth="100.0" text="ID" />
                                        <TableColumn fx:id="colCAccount" prefWidth="120.0" text="Cuenta" />
                                        <TableColumn fx:id="colCBalance" prefWidth="100.0" text="Saldo" />
                                        <TableColumn fx:id="colCType" prefWidth="120.0" text="Tipo" />
                                    </columns>
                                </TableView>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab closable="false" text="Cajeros">
                    <content>
                        <AnchorPane>
                            <children>
                                <TitledPane text="Gestionar cajeros" collapsible="false" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
                                    <content>
                                        <VBox spacing="8.0">
                                            <children>
                                                <HBox spacing="8.0">
                                                    <children>
                                                        <Label text="Seleccionar cajero:" />
                                                        <ComboBox fx:id="cmbCashiers" prefWidth="220.0" />
                                                        <Button onAction="#onLoadCashierFromDropdown" text="Cargar" />
                                                    </children>
                                                </HBox>
                                                <GridPane hgap="8" vgap="8">
                                                    <columnConstraints>
                                                        <ColumnConstraints percentWidth="20" />
                                                        <ColumnConstraints percentWidth="30" />
                                                        <ColumnConstraints percentWidth="20" />
                                                        <ColumnConstraints percentWidth="30" />
                                                    </columnConstraints>
                                                    <children>
                                                        <Label text="Usuario" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                                        <TextField fx:id="txtCashierUser" promptText="usuario" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                                        <Label text="Contraseña" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                                        <PasswordField fx:id="txtCashierPassword" promptText="contraseña" GridPane.columnIndex="3" GridPane.rowIndex="0" />
                                                    </children>
                                                </GridPane>
                                                <HBox spacing="8.0" alignment="CENTER_RIGHT">
                                                    <children>
                                                        <Button onAction="#onAddCashier" text="Agregar" />
                                                        <Button onAction="#onUpdateCashier" text="Actualizar" />
                                                        <Button fx:id="btnRemoveCashier" onAction="#onRemoveCashier" text="Eliminar" />
                                                        <Button fx:id="btnPromoteCashier" onAction="#onPromoteCashierToAdmin" text="Hacer Admin" />
                                                    </children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </content>
                                </TitledPane>

                                <TableView id="tblCashiers" fx:id="tblCashiers" editable="false" style="-fx-control-inner-background: white; -fx-background-color: transparent;" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="200.0">
                                    <columns>
                                        <TableColumn fx:id="colCashierUser" prefWidth="200.0" style="-fx-text-fill: black" text="Usuario" />
                                    </columns>
                                </TableView>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
                <Tab closable="false" text="Admins">
                    <content>
                        <AnchorPane>
                            <children>
                                <TableView id="tblAdmins" fx:id="tblAdmins" editable="false" style="-fx-control-inner-background: white; -fx-background-color: transparent;" AnchorPane.bottomAnchor="60.0" AnchorPane.leftAnchor="12.0" AnchorPane.rightAnchor="12.0" AnchorPane.topAnchor="12.0">
                                    <columns>
                                        <TableColumn fx:id="colAdminUser" prefWidth="200.0" text="Usuario" />
                                    </columns>
                                </TableView>
                                <HBox spacing="8.0" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="12.0">
                                    <children>
                                        <Button fx:id="btnRemoveAdmin" onAction="#onRemoveAdmin" style="-fx-background-color: #4B5563; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Eliminar admin" />
                                    </children>
                                </HBox>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
