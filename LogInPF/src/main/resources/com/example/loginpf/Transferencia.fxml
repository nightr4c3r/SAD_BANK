<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="layout" prefHeight="525.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.loginpf.Controllers.TransactionController" style="-fx-background-color: #ECEFF3; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 12, 0, 0, 2);">

    <Button text="Volver" onAction="#onBack" AnchorPane.leftAnchor="8.0" AnchorPane.topAnchor="8.0" style="-fx-background-color: #4B5563; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" />

    <TextField fx:id="txtCuenta" alignment="CENTER" promptText="Ingrese cuenta" AnchorPane.leftAnchor="75.0" AnchorPane.rightAnchor="75.0" AnchorPane.topAnchor="46.0" />

    <TextField fx:id="txtMonto" alignment="CENTER" promptText="Ingrese monto" AnchorPane.leftAnchor="75.0" AnchorPane.rightAnchor="75.0" AnchorPane.topAnchor="106.0" />
    <TextArea fx:id="txtMensaje" prefHeight="40.0" prefWidth="250.0" promptText="Mensaje (opcional)" AnchorPane.leftAnchor="75.0" AnchorPane.rightAnchor="75.0" AnchorPane.topAnchor="156.0" />

    <Button fx:id="btnInfo" mnemonicParsing="false" onAction="#onInfo" prefHeight="30.0" prefWidth="83.0" text="Info" AnchorPane.leftAnchor="158.0" AnchorPane.topAnchor="206.0" style="-fx-background-color: #4B5563; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" />

    <TableView fx:id="tblAccounts" AnchorPane.leftAnchor="32.0" AnchorPane.rightAnchor="32.0" AnchorPane.topAnchor="246.0" AnchorPane.bottomAnchor="70.0" style="-fx-control-inner-background: white; -fx-background-color: transparent; -fx-selection-bar: #DDE3EA; -fx-selection-bar-non-focused: #DDE3EA; -fx-selection-bar-text: black;">
      <columns>
        <TableColumn fx:id="colAccount" prefWidth="112.8" text="Numero de cuenta" />
        <TableColumn fx:id="colName" prefWidth="111.2" text="Nombre" />
        <TableColumn fx:id="colId" prefWidth="104.8" text="ID" />
      </columns>
    </TableView>

    <Button fx:id="btnTransferir" mnemonicParsing="false" onAction="#onTransferir" text="Transferir" AnchorPane.bottomAnchor="16.0" AnchorPane.leftAnchor="158.0" style="-fx-background-color: #4B5563; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" />
</AnchorPane>
