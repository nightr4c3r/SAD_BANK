<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane fx:id="pane" prefHeight="600.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.loginpf.Controllers.LogInController" style="-fx-background-color: #F5F7FA;">
   <children>
      <AnchorPane fx:id="anchorContainer" prefHeight="500.0" prefWidth="400.0" AnchorPane.topAnchor="50.0" AnchorPane.bottomAnchor="50.0" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" style="-fx-background-color: #ECEFF3; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 12, 0, 0, 2);">
         <children>
            <Label layoutX="138.0" layoutY="14.0" text="SAD Bank" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #0B0F12;" />
            <Label fx:id="lblUser" layoutX="50.0" layoutY="80.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0B0F12;" text="User:" />
            <ComboBox fx:id="comboUser" layoutX="50.0" layoutY="110.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" prefWidth="300.0" promptText="Seleccione tipo de usuario" />
            <Label fx:id="lblUserName" layoutX="50.0" layoutY="160.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0B0F12;" text="Username:" />
            <TextField fx:id="txtUserName" layoutX="50.0" layoutY="190.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" prefWidth="300.0" promptText="Ingrese su usuario" />
            <Label fx:id="lblPassword" layoutX="50.0" layoutY="240.0" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #0B0F12;" text="Password" />
            <PasswordField fx:id="txtPassword" layoutX="50.0" layoutY="270.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0" prefWidth="300.0" promptText="Ingrese su contraseña" />
            <Button fx:id="btnLogIn" layoutX="125.0" layoutY="330.0" onAction="#onLogIn" prefHeight="40.0" prefWidth="150.0" text="Log In" style="-fx-background-color: #4B5563; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" />
            <AnchorPane fx:id="anchorView" layoutY="390.0" prefHeight="110.0" prefWidth="400.0" style="-fx-background-color: transparent;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0">
               <children>
                  <Hyperlink fx:id="hypCreate" layoutX="150.0" layoutY="30.0" onAction="#onCreateAccount" text="Create Account" />
               </children>
            </AnchorPane>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>
